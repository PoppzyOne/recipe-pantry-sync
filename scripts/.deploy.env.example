# ===================================================================
# Deploy Configuration for Recipe & Pantry Sync
# Copy this file to 'scripts/.deploy.env' or '.deploy.env' and fill in your details:
#   cp scripts/.deploy.env.example scripts/.deploy.env
# ===================================================================

# SSH destination: username@hostname-or-ip (or an alias from your ~/.ssh/config)
DEPLOY_HOST="poppe@192.168.1.50"

# Target directory on the remote server
DEPLOY_DIR="/home/poppe/repos/recipe-pantry-sync"

# Git branch to pull and deploy
DEPLOY_BRANCH="main"

# Optional custom SSH port (defaults to 22)
# SSH_PORT="22"

# Set to true to skip docker image pruning after build (defaults to false)
# SKIP_PRUNE=false
